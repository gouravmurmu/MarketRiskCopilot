# Copy to backend/.env for local runs. Never commit real values.
DATABASE_URL=postgresql://postgres:password@localhost:5432/riskcopilot
FRED_API_KEY=
CORS_ORIGINS=http://localhost:3000
# Bearer token for POST /jobs/eod (leave empty to disable the endpoint)
EOD_TOKEN=
# Optional bearer token for approving commentary (leave empty to allow anyone)
APPROVE_TOKEN=
# AI copilot (leave empty to disable chat and commentary drafting)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
CHAT_DAILY_LIMIT=200
